{
  "paths": {
    "session_root": "X:/replace-with-external-session",
    "workspace_root": "X:/replace-with-private-workspace",
    "repository_root": "X:/replace-with-repository"
  },
  "exiftool": {
    "executable": "X:/replace-with-local-tools/exiftool.exe",
    "timeout_seconds": 10,
    "max_output_bytes": 65536
  },
  "xmp": {
    "max_bytes": 262144
  },
  "lightroom_export_relative_directory": "export-app",
  "review_package": {
    "max_jpg_bytes": 25000000,
    "max_package_bytes": 250000000
  },
  "proxy": {
    "long_edge_px": 2048,
    "jpeg_quality": 85,
    "max_source_bytes": 25000000,
    "max_source_pixels": 100000000
  },
  "contact_sheet": {
    "columns": 4,
    "cell_width_px": 520,
    "thumbnail_height_px": 360,
    "label_height_px": 58,
    "padding_px": 12,
    "jpeg_quality": 85,
    "max_output_pixels": 100000000,
    "max_proxy_bytes": 10000000
  }
}
